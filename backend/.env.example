# Variaveis de ambiente do backend
# ================================
# Copie este arquivo para `.env` e preencha os valores reais.
# NAO versione o arquivo .env no git!

# Email do admin (senha e gerada automaticamente na 1a execucao)
ADMIN_EMAIL=admin@seudominio.com.br

# Senha do admin - se definida, o sistema sincroniza ela + o ADMIN_EMAIL
# no banco a cada startup (o .env vira a fonte da verdade do login).
# Deixe vazio para senha aleatoria na 1a execucao.
ADMIN_PASSWORD=

# Chave secreta do JWT - TROQUE por uma chave aleatoria!
SECRET_KEY=mude-esta-chave-para-uma-aleatoria-muito-longa-1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Banco de dados MySQL - EXEMPLO generico (preencha com os dados reais do
# seu ambiente no arquivo .env local; nunca versione o .env!)
DB_HOST=mysql-seu-servidor.example.com
DB_PORT=3306
DB_USER=usuario_exemplo
DB_PASSWORD=senha_exemplo
DB_NAME=banco_exemplo

# Uploads
UPLOAD_DIR=../uploads

# CORS - dominios permitidos (separados por virgula)
# Em producao use: https://music.seudominio.com,https://api.seudominio.com
CORS_ORIGINS=*